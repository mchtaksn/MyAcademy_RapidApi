@model RapidApi.Web.Models.HotelListViewModel
@{
    ViewData["Title"] = Model.Form.Destination + " Otelleri";
    ViewData["ActiveNav"] = "hotels";
}

@section Styles {
/* ---------- Breadcrumb ---------- */
.sf-breadcrumb { font-size: .85rem; padding: 1.6rem 0 0; margin: 0; }
.sf-breadcrumb a { color: var(--text-faint); font-weight: 600; }
.sf-breadcrumb a:hover { color: var(--brass-dark); }
.sf-breadcrumb .breadcrumb-item + .breadcrumb-item::before { content: "/"; color: var(--text-faint); }
.sf-breadcrumb .active { color: var(--ink); font-weight: 700; }

.page-title { font-size: clamp(2rem, 3.4vw, 2.9rem); margin: .6rem 0 .3rem; }
.page-text { color: var(--text-soft); margin-bottom: 2rem; }

/* ---------- Arama özeti (bilet kökü) ---------- */
.summary-strip {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    margin-bottom: 3rem;
}

.summary-strip::before, .summary-strip::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--paper);
    transform: translateY(-50%);
}

.summary-strip::before { left: -12px; }
.summary-strip::after { right: -12px; }

.summary-panel .row { align-items: center; }

.summary-field {
    display: flex;
    align-items: center;
    gap: .7rem;
    cursor: text;
}

.summary-field i { color: var(--brass); font-size: 1rem; flex-shrink: 0; }

.summary-body { display: flex; flex-direction: column; min-width: 0; }

.summary-label {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .03em;
    color: rgba(251, 249, 245, .55);
}

.summary-input {
    border: 0;
    background: transparent;
    color: var(--paper);
    font-weight: 700;
    font-size: .98rem;
    padding: 0;
    width: 100%;
}

.summary-input:focus { outline: none; }
.summary-input::-webkit-calendar-picker-indicator { filter: invert(1); opacity: .6; }

.summary-value { font-weight: 700; font-size: .98rem; }

.btn-update {
    background: var(--brass);
    color: var(--ink);
    border: 0;
    border-radius: 999px;
    font-weight: 700;
    font-size: .9rem;
    padding: .75rem 1.3rem;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    transition: background-color .25s var(--ease), transform .25s var(--ease);
}

.btn-update:hover { background: #D79B4F; transform: translateY(-1px); }

/* ---------- Sonuç başlığı ---------- */
.results-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
}

.results-count h2 { font-size: 1.4rem; font-weight: 700; font-family: var(--sans); color: var(--ink); }
.results-count h2 strong { color: var(--brass-dark); font-weight: 800; }
.results-count span { font-size: .85rem; color: var(--text-faint); }

.toolbar-actions { display: flex; align-items: center; gap: .9rem; }

.sort-box { display: flex; align-items: center; gap: .5rem; font-size: .85rem; font-weight: 600; color: var(--text-soft); }

.sort-select {
    border: 1.5px solid var(--paper-line);
    border-radius: 999px;
    padding: .5rem 1rem;
    font-weight: 700;
    color: var(--ink);
    font-size: .85rem;
}

.btn-filter {
    border: 1.5px solid var(--paper-line);
    background: var(--paper);
    border-radius: 999px;
    padding: .55rem 1.1rem;
    font-weight: 700;
    font-size: .85rem;
    color: var(--ink);
}

/* ---------- Filtreler ---------- */
.filters-card {
    background: var(--paper);
    border: 1.5px solid var(--paper-line);
    border-radius: var(--radius-lg);
    padding: 1.7rem;
    position: sticky;
    top: 110px;
}

.filters-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
.filters-head h2 { font-size: 1.15rem; font-family: var(--sans); font-weight: 700; }
.clear-link { font-size: .82rem; font-weight: 700; color: var(--brass-dark); }

.filter-accordion .accordion-item { border: 0; border-top: 1px solid var(--paper-line); background: transparent; }
.filter-accordion .accordion-item:first-child { border-top: 0; }

.filter-accordion .accordion-button {
    background: transparent;
    font-weight: 700;
    font-size: .92rem;
    color: var(--ink);
    padding: 1.1rem 0;
    box-shadow: none !important;
}

.filter-accordion .accordion-button::after { filter: sepia(1) hue-rotate(10deg) saturate(2); }
.filter-accordion .accordion-body { padding: 0 0 1.3rem; }

.price-range { position: relative; height: 4px; background: var(--paper-line); border-radius: 999px; margin: 1.6rem 0 .6rem; }
.price-fill { position: absolute; left: 12%; right: 22%; top: 0; bottom: 0; background: var(--brass); border-radius: 999px; }
.price-thumb { position: absolute; top: 50%; width: 16px; height: 16px; border-radius: 50%; background: var(--paper); border: 3px solid var(--brass); transform: translate(-50%, -50%); }
.price-scale { display: flex; justify-content: space-between; font-size: .76rem; color: var(--text-faint); margin-bottom: .9rem; }

.mini-label { font-size: .7rem; font-weight: 700; color: var(--text-faint); display: block; margin-bottom: .25rem; }
.price-input { display: flex; align-items: center; gap: .3rem; border: 1.5px solid var(--paper-line); border-radius: var(--radius-sm); padding: .4rem .6rem; }
.price-input span { color: var(--text-faint); font-size: .85rem; }
.price-input input { border: 0; width: 100%; font-weight: 700; color: var(--ink); }
.price-input input:focus { outline: none; }

.filter-option {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .4rem 0;
    cursor: pointer;
    font-size: .88rem;
    color: var(--text-soft);
}

.filter-option .form-check-input { width: 17px; height: 17px; border-color: var(--paper-line); margin: 0; }
.filter-option .form-check-input:checked { background-color: var(--brass); border-color: var(--brass); }
.option-text { flex: 1; }
.option-count { color: var(--text-faint); font-size: .78rem; }

/* ---------- Otel kartları ---------- */
.hotel-list { display: flex; flex-direction: column; gap: 1.6rem; }

.hotel-card {
    display: grid;
    grid-template-columns: 300px 1fr auto;
    gap: 1.8rem;
    background: var(--paper);
    border: 1.5px solid var(--paper-line);
    border-radius: var(--radius-lg);
    padding: 1.1rem;
    opacity: 0;
    transform: translateY(16px);
    animation: cardIn .6s var(--ease) forwards;
    transition: box-shadow .35s var(--ease), border-color .35s var(--ease), transform .35s var(--ease);
}

.hotel-card:hover {
    box-shadow: var(--shadow);
    border-color: transparent;
    transform: translateY(-3px);
}

@@keyframes cardIn { to { opacity: 1; transform: translateY(0); } }

.hotel-card:nth-child(1) { animation-delay: .04s; }
.hotel-card:nth-child(2) { animation-delay: .1s; }
.hotel-card:nth-child(3) { animation-delay: .16s; }
.hotel-card:nth-child(4) { animation-delay: .22s; }
.hotel-card:nth-child(5) { animation-delay: .28s; }
.hotel-card:nth-child(6) { animation-delay: .34s; }
.hotel-card:nth-child(n+7) { animation-delay: .4s; }

.hotel-media { position: relative; border-radius: var(--radius); overflow: hidden; }

.hotel-media img { width: 100%; height: 100%; min-height: 210px; object-fit: cover; transition: transform .6s var(--ease); }
.hotel-card:hover .hotel-media img { transform: scale(1.07); }

.hotel-media .fav-btn { position: absolute; top: .7rem; right: .7rem; }

.hotel-info { display: flex; flex-direction: column; min-width: 0; padding: .3rem 0; }

.hotel-name { font-size: 1.3rem; margin-bottom: .35rem; }
.hotel-name a:hover { color: var(--brass-dark); }

.hotel-stars { display: flex; align-items: center; gap: .5rem; margin-bottom: .6rem; }
.hotel-stars .stars { color: var(--brass); letter-spacing: 1px; font-size: .85rem; }
.hotel-stars .stars-text { font-size: .8rem; color: var(--text-faint); font-weight: 600; }

.hotel-location { display: flex; align-items: center; gap: .4rem; font-size: .88rem; color: var(--text-soft); font-weight: 600; margin-bottom: .6rem; }
.hotel-location i { color: var(--brass-dark); }

.hotel-desc {
    font-size: .88rem;
    color: var(--text-soft);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: auto;
}

.hotel-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    text-align: right;
    min-width: 160px;
    padding: .3rem 0;
}

.rating-block { display: flex; align-items: center; gap: .7rem; }
.rating-text { line-height: 1.25; }
.rating-text strong { display: block; font-size: .86rem; color: var(--ink); }
.rating-text span { font-size: .76rem; color: var(--text-faint); }

.price-block { display: flex; flex-direction: column; align-items: flex-end; gap: .55rem; }
.price-tag { font-family: var(--serif); font-size: 1.8rem; color: var(--ink); }
.price-tag span { font-size: .78rem; font-family: var(--sans); color: var(--text-faint); font-weight: 600; display: block; }

.btn-detail {
    background: transparent;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    border-radius: 999px;
    font-weight: 700;
    font-size: .85rem;
    padding: .6rem 1.2rem;
    transition: background-color .25s var(--ease), color .25s var(--ease);
    white-space: nowrap;
}

.btn-detail:hover { background: var(--ink); color: var(--paper); }

/* ---------- Boş / hata durumu ---------- */
.search-state { grid-column: 1 / -1; }

/* ---------- Sayfalama ---------- */
.pagination-wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; }
.pagination-info { font-size: .85rem; color: var(--text-faint); }
.sf-pagination { gap: .35rem; }
.sf-pagination .page-link {
    border: 1.5px solid var(--paper-line);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 700;
    font-size: .85rem;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}
.sf-pagination .page-item.active .page-link { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.sf-pagination .page-item.disabled .page-link { opacity: .4; }

@@media (max-width: 991.98px) {
    .hotel-card { grid-template-columns: 1fr; }
    .hotel-media img { min-height: 200px; }
    .hotel-side { flex-direction: row; align-items: center; justify-content: space-between; text-align: left; width: 100%; }
    .price-block { align-items: flex-end; }
    .filters-card { position: static; margin-bottom: 1.5rem; }
}

@@media (max-width: 575.98px) {
    .summary-strip { padding: 1.3rem 1.2rem; }
    .summary-strip .row > div { margin-bottom: .9rem; }
}
}

<main>
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb sf-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Hotel" asp-action="List">Oteller</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Form.Destination</li>
            </ol>
        </nav>

        <h1 class="page-title">@Model.Form.Destination Otelleri</h1>
        <p class="page-text">@Model.Form.Destination bölgesindeki konaklama seçeneklerini keşfet.</p>

        <!-- Arama Özeti -->
        <div class="summary-strip">
            <form class="summary-panel" asp-controller="Hotel" asp-action="List" method="get" role="search">
                <div class="row g-3 align-items-center">
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="summary-field" for="sDestination">
                            <i class="bi bi-geo-alt"></i>
                            <span class="summary-body">
                                <span class="summary-label">LOKASYON</span>
                                <input type="text" id="sDestination" name="destination" class="summary-input" value="@Model.Form.Destination">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="summary-field" for="sCheckin">
                            <i class="bi bi-calendar3"></i>
                            <span class="summary-body">
                                <span class="summary-label">GİRİŞ</span>
                                <input type="date" id="sCheckin" name="checkin" class="summary-input" value="@Model.Form.Checkin">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="summary-field" for="sCheckout">
                            <i class="bi bi-calendar3"></i>
                            <span class="summary-body">
                                <span class="summary-label">ÇIKIŞ</span>
                                <input type="date" id="sCheckout" name="checkout" class="summary-input" value="@Model.Form.Checkout">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="summary-field">
                            <i class="bi bi-people"></i>
                            <span class="summary-body">
                                <span class="summary-label">MİSAFİR</span>
                                <span class="summary-value">@Model.Form.Adults Yetişkin, @Model.Form.Children Çocuk</span>
                            </span>
                        </div>
                        <input type="hidden" name="adults" value="@Model.Form.Adults">
                        <input type="hidden" name="children" value="@Model.Form.Children">
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="summary-field" for="sCurrency">
                            <i class="bi bi-cash-coin"></i>
                            <span class="summary-body">
                                <span class="summary-label">PARA BİRİMİ</span>
                                <select id="sCurrency" name="currency" class="summary-input">
                                    <option value="EUR" selected="@(Model.Form.Currency == "EUR")">EUR</option>
                                    <option value="USD" selected="@(Model.Form.Currency == "USD")">USD</option>
                                    <option value="TRY" selected="@(Model.Form.Currency == "TRY")">TRY</option>
                                    <option value="GBP" selected="@(Model.Form.Currency == "GBP")">GBP</option>
                                </select>
                            </span>
                        </label>
                    </div>
                    <div class="col-12 col-lg-2 d-grid">
                        <button type="submit" class="btn-update"><i class="bi bi-search"></i> <span>Aramayı Güncelle</span></button>
                    </div>
                </div>
            </form>
        </div>

        <div class="row g-4">
            <!-- Filtreler -->
            <aside class="col-lg-3">
                <div class="filters-card reveal">
                    <div class="filters-head">
                        <h2>Filtreler</h2>
                        <a href="#" class="clear-link">Tümünü Temizle</a>
                    </div>

                    <div class="accordion filter-accordion" id="filterAccordion">
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#fPrice" aria-expanded="true" aria-controls="fPrice">
                                    Gecelik Fiyat
                                </button>
                            </h3>
                            <div id="fPrice" class="accordion-collapse collapse show">
                                <div class="accordion-body">
                                    <div class="price-range" aria-hidden="true">
                                        <div class="price-fill"></div>
                                        <span class="price-thumb" style="left: 12%"></span>
                                        <span class="price-thumb" style="left: 78%"></span>
                                    </div>
                                    <div class="price-scale"><span>€50</span><span>€500+</span></div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="mini-label" for="minPrice">Minimum</label>
                                            <div class="price-input"><span>€</span><input type="number" id="minPrice" value="100"></div>
                                        </div>
                                        <div class="col-6">
                                            <label class="mini-label" for="maxPrice">Maksimum</label>
                                            <div class="price-input"><span>€</span><input type="number" id="maxPrice" value="400"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#fStars" aria-expanded="false" aria-controls="fStars">
                                    Yıldız Sayısı
                                </button>
                            </h3>
                            <div id="fStars" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    <label class="filter-option"><input class="form-check-input" type="checkbox" checked><span class="option-text">★★★★★ 5 Yıldız</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox" checked><span class="option-text">★★★★ 4 Yıldız</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">★★★ 3 Yıldız</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">★★ 2 Yıldız</span></label>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#fFacilities" aria-expanded="false" aria-controls="fFacilities">
                                    Popüler Özellikler
                                </button>
                            </h3>
                            <div id="fFacilities" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    <label class="filter-option"><input class="form-check-input" type="checkbox" checked><span class="option-text">Ücretsiz Wi-Fi</span><span class="option-count">412</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">Kahvaltı Dahil</span><span class="option-count">187</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">Otopark</span><span class="option-count">134</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">Klima</span><span class="option-count">398</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">Havuz</span><span class="option-count">22</span></label>
                                    <label class="filter-option"><input class="form-check-input" type="checkbox"><span class="option-text">Spa</span><span class="option-count">31</span></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Sonuçlar -->
            <div class="col-lg-9">
                <div class="results-toolbar">
                    <div class="results-count">
                        <h2>@Model.Form.Destination için <strong>@Model.Hotels.Count konaklama</strong> bulundu</h2>
                        <span>@Model.Form.Checkin &ndash; @Model.Form.Checkout</span>
                    </div>
                    <div class="toolbar-actions">
                        <button class="btn-filter d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterAccordion">
                            <i class="bi bi-sliders"></i> Filtrele
                        </button>
                        <div class="sort-box">
                            <span><i class="bi bi-arrow-down-up"></i> Sırala</span>
                            <select class="sort-select">
                                <option>Önerilen</option>
                                <option>En Düşük Fiyat</option>
                                <option>En Yüksek Puan</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="hotel-list">
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="state-panel search-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2 L14 9 L21 11 L14 13 L12 20 L10 13 L3 11 L10 9 Z" stroke-linejoin="round"/></svg>
                            <h3>Bu aramada bir pürüz çıktı</h3>
                            <p>@Model.ErrorMessage</p>
                        </div>
                    }
                    else if (!Model.Hotels.Any())
                    {
                        <div class="state-panel search-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
                            <h3>Bu kriterlere uygun otel bulunamadı</h3>
                            <p>Tarihleri veya misafir sayısını değiştirip tekrar dene.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var hotel in Model.Hotels)
                        {
                            <article class="hotel-card" data-hotel-id="@hotel.HotelId">
                                <div class="hotel-media">
                                    <img src="@hotel.PhotoUrl" alt="@hotel.Name" loading="lazy">
                                    <button type="button" class="fav-btn" aria-label="Favorilere ekle"><i class="bi bi-heart"></i></button>
                                </div>

                                <div class="hotel-info">
                                    <h3 class="hotel-name">
                                        <a asp-controller="Hotel" asp-action="Details" asp-route-id="@hotel.HotelId" asp-route-checkin="@Model.Form.Checkin" asp-route-checkout="@Model.Form.Checkout">@hotel.Name</a>
                                    </h3>
                                    <div class="hotel-stars">
                                        <span class="stars" aria-label="@hotel.Stars yıldız">@(new string('★', hotel.Stars))</span>
                                        <span class="stars-text">@hotel.Stars Yıldızlı Otel</span>
                                    </div>
                                    <p class="hotel-location"><i class="bi bi-geo-alt"></i> <span>@hotel.LocationText</span></p>
                                    <p class="hotel-desc">@hotel.Description</p>
                                </div>

                                <div class="hotel-side">
                                    <div class="rating-block">
                                        <div class="rating-text">
                                            <strong>@hotel.ReviewScoreWord</strong>
                                            <span>@hotel.ReviewCount değerlendirme</span>
                                        </div>
                                        <span class="stamp stamp-brass">@hotel.ReviewScore</span>
                                    </div>
                                    <div class="price-block">
                                        <span class="price-tag">@hotel.PriceText<span>toplam fiyat</span></span>
                                        <a asp-controller="Hotel" asp-action="Details" asp-route-id="@hotel.HotelId" asp-route-checkin="@Model.Form.Checkin" asp-route-checkout="@Model.Form.Checkout" class="btn-detail">Detayları Gör</a>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>

                @if (Model.ErrorMessage == null && Model.Hotels.Any())
                {
                    <nav class="pagination-wrap" aria-label="Sonuç sayfaları">
