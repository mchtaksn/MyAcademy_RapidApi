@model RapidApi.Web.Models.HotelDetailViewModel
@{
    ViewData["Title"] = Model.ErrorMessage != null ? "Otel bulunamadı" : Model.Name;
    ViewData["ActiveNav"] = "hotels";
}

@section Styles {
/* ---------- Hata durumu ---------- */
.detail-error { padding: 5rem 0; }

/* ---------- Galeri hero ---------- */
.gallery-hero {
    position: relative;
    height: 58vh;
    min-height: 420px;
    max-height: 620px;
    overflow: hidden;
}

.gallery-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 10s var(--ease) forwards;
}

@@keyframes heroZoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
}

.gallery-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 39, 34, .88) 0%, rgba(18, 39, 34, .25) 45%, transparent 70%);
}

.gallery-hero-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3rem 0 2.2rem;
    color: var(--paper);
    opacity: 0;
    transform: translateY(14px);
    animation: heroCopyIn .7s .25s var(--ease) forwards;
}

@@keyframes heroCopyIn { to { opacity: 1; transform: translateY(0); } }

.gallery-hero .sf-breadcrumb { padding: 0; margin-bottom: .9rem; }
.gallery-hero .sf-breadcrumb a { color: rgba(251, 249, 245, .7); }
.gallery-hero .sf-breadcrumb .active { color: var(--paper); }
.gallery-hero .sf-breadcrumb .breadcrumb-item + .breadcrumb-item::before { color: rgba(251, 249, 245, .4); }

.hero-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }

.hotel-title { font-size: clamp(2.1rem, 3.8vw, 3.1rem); color: var(--paper); max-width: 22ch; }

.hotel-address { display: flex; align-items: center; gap: .5rem; margin-top: .6rem; color: rgba(251, 249, 245, .82); font-weight: 600; }
.hotel-address i { color: var(--brass); }

.hero-actions { display: flex; align-items: center; gap: .6rem; flex-shrink: 0; }

/* ---------- İçerik grid ---------- */
.detail-body { padding: 3.2rem 0 0; }
.detail-grid { display: grid; grid-template-columns: 56px minmax(0, 1fr) 360px; gap: 2.8rem; align-items: start; }

/* Scroll-spy yan rayı */
.side-rail {
    position: sticky;
    top: 130px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: .4rem;
}

.side-rail a {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--paper-line);
    position: relative;
    transition: background-color .3s var(--ease), border-color .3s var(--ease);
}

.side-rail a span {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: .78rem;
    font-weight: 700;
    color: var(--text-faint);
    opacity: 0;
    transition: opacity .25s var(--ease);
    pointer-events: none;
}

.side-rail a:hover span { opacity: 1; }

.side-rail a.is-active { background: var(--brass); border-color: var(--brass); }
.side-rail a.is-active span { opacity: 1; color: var(--brass-dark); }

.side-rail::before {
    content: "";
    position: absolute;
    left: 4.5px;
    top: 5px;
    bottom: 5px;
    width: 1px;
    background: var(--paper-line);
    z-index: -1;
}

/* İçerik blokları */
.detail-block { padding-bottom: 3.4rem; margin-bottom: 3.4rem; border-bottom: 1px solid var(--paper-line); scroll-margin-top: 130px; }
.detail-block:last-child { border-bottom: 0; }

.block-title { font-size: 1.7rem; margin-bottom: 1.2rem; }

.about-text p { max-width: 68ch; color: var(--text-soft); font-size: 1rem; line-height: 1.75; }

/* Özellikler */
.facility-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .7rem 1.4rem; }

.facility-item {
    display: flex;
    align-items: center;
    gap: .85rem;
    padding: .7rem .4rem;
    border-radius: var(--radius-sm);
    transition: background-color .25s var(--ease), transform .25s var(--ease);
}

.facility-item:hover { background: var(--paper-dim); transform: translateX(3px); }

.facility-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--brass-soft);
    color: var(--brass-dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}

.facility-text strong { font-size: .92rem; color: var(--ink); font-weight: 600; }

/* Konum */
.location-card { border-radius: var(--radius); overflow: hidden; background: var(--paper-dim); }
.map-placeholder { position: relative; height: 240px; }
.map-placeholder svg { width: 100%; height: 100%; display: block; }
.map-pin { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -100%); display: flex; flex-direction: column; align-items: center; }
.map-pin i { font-size: 2.4rem; color: var(--brass-dark); filter: drop-shadow(0 6px 10px rgba(195, 138, 63, .4)); }
.map-pin-label { background: var(--ink); color: var(--paper); font-size: .78rem; font-weight: 700; padding: .3rem .75rem; border-radius: 999px; margin-bottom: .3rem; white-space: nowrap; }
.location-body { padding: 1.3rem 1.5rem 1.6rem; }
.location-address { display: flex; align-items: center; gap: .45rem; font-weight: 700; color: var(--ink); margin-bottom: 1rem; }
.location-address i { color: var(--brass-dark); }
.nearby-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .2rem 2rem; list-style: none; padding: 0; margin: 0; }
.nearby-list li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--paper-line); font-size: .9rem; }
.nearby-list span { display: inline-flex; align-items: center; gap: .5rem; color: var(--text-soft); }
.nearby-list i { color: var(--text-faint); }
.nearby-list strong { color: var(--ink); white-space: nowrap; }

/* Odalar */
.room-list { display: flex; flex-direction: column; gap: 1.1rem; }

.room-card {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 180px;
    gap: 1.3rem;
    padding: .85rem;
    border-radius: var(--radius);
    background: var(--paper-dim);
    transition: box-shadow .3s var(--ease), background-color .3s var(--ease);
}

.room-card:hover { background: var(--paper); box-shadow: var(--shadow-sm); }
.room-card-featured { background: var(--paper); box-shadow: 0 0 0 2px var(--brass); }

.room-media { position: relative; min-height: 160px; border-radius: var(--radius-sm); overflow: hidden; }
.room-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.room-media-badge { position: absolute; left: .6rem; top: .6rem; background: var(--brass); color: var(--ink); font-size: .68rem; font-weight: 800; padding: .3rem .65rem; border-radius: 999px; }

.room-info { padding: .4rem 0; min-width: 0; }
.room-name { font-size: 1.1rem; margin-bottom: .55rem; }
.room-specs, .room-perks { display: flex; flex-wrap: wrap; list-style: none; padding: 0; margin: 0 0 .55rem; }
.room-specs { gap: .3rem 1rem; font-size: .84rem; color: var(--ink); font-weight: 600; }
.room-specs li, .room-perks li { display: inline-flex; align-items: center; gap: .35rem; }
.room-specs i { color: var(--brass-dark); }
.room-perks { gap: .4rem; }
.room-perks li { font-size: .76rem; font-weight: 600; background: var(--paper); padding: .26rem .6rem; border-radius: 999px; border: 1px solid var(--paper-line); }
.room-perks .perk-positive { color: var(--moss); background: var(--moss-soft); border-color: transparent; }
.policy-text { font-size: .78rem; color: var(--text-faint); font-weight: 600; }
.policy-free { color: var(--moss); }

.room-price { display: flex; flex-direction: column; align-items: flex-end; justify-content: flex-end; text-align: right; padding: .4rem .3rem; gap: .3rem; }
.room-price .price-meta { font-size: .76rem; color: var(--text-faint); }
.room-price .price { font-family: var(--serif); font-size: 1.5rem; color: var(--ink); }
.room-price .price-note { font-size: .72rem; color: var(--text-faint); margin-bottom: .3rem; }

/* Değerlendirmeler */
.review-summary { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 2rem; align-items: center; }
.review-score-box { display: flex; flex-direction: column; align-items: center; text-align: center; background: var(--paper-dim); border-radius: var(--radius); padding: 1.4rem 1rem; }
.review-big { font-family: var(--serif); font-size: 2.7rem; color: var(--brass-dark); line-height: 1; margin-bottom: .3rem; }
.review-score-box strong { font-size: 1rem; color: var(--ink); }
.review-score-box span:last-child { font-size: .78rem; color: var(--text-faint); }
.review-bars { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem 2rem; }
.bar-row { display: grid; grid-template-columns: minmax(0, 1fr) 34px; grid-template-areas: "label value" "track track"; gap: .25rem .5rem; align-items: center; }
.bar-label { grid-area: label; font-size: .85rem; font-weight: 600; color: var(--ink); }
.bar-value { grid-area: value; font-size: .85rem; font-weight: 800; color: var(--ink); text-align: right; }
.bar-track { grid-area: track; height: 6px; background: var(--paper-line); border-radius: 999px; overflow: hidden; }
.bar-fill { height: 100%; background: var(--brass); border-radius: 999px; width: 0; transition: width 1.1s var(--ease); }
.bar-row.is-visible .bar-fill { width: var(--w); }

.review-card { background: var(--paper-dim); border-radius: var(--radius); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; gap: .9rem; height: 100%; }
.review-card blockquote { margin: 0; color: var(--ink); font-weight: 600; font-size: .94rem; }
.review-card figcaption { display: flex; align-items: center; gap: .65rem; }
.review-card figcaption > span:nth-child(2) { flex: 1; display: flex; flex-direction: column; line-height: 1.3; }
.review-card figcaption strong { color: var(--ink); font-size: .88rem; }
.review-card figcaption small { color: var(--text-faint); font-size: .76rem; }
.review-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--paper); font-weight: 800; display: inline-flex; align-items: center; justify-content: center; font-size: .82rem; flex-shrink: 0; }
.review-mini { font-weight: 800; font-size: .82rem; color: var(--brass-dark); background: var(--brass-soft); padding: .2rem .55rem; border-radius: 8px; }

/* ---------- Rezervasyon kartı ---------- */
.booking-card {
    position: sticky;
    top: 130px;
    background: rgba(251, 249, 245, .72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid var(--paper-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 1.8rem;
}

.booking-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; }
.booking-title { font-size: 1.2rem; }

.rating-ring { position: relative; width: 58px; height: 58px; }
.rating-ring svg { transform: rotate(-90deg); }
.rating-ring circle { fill: none; stroke-width: 5; }
.rating-ring .ring-track { stroke: var(--paper-line); }
.rating-ring .ring-fill {
    stroke: var(--brass);
    stroke-linecap: round;
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: ringFill 1.3s .4s var(--ease) forwards;
}
.rating-ring .ring-score {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--ink);
}

@@keyframes ringFill { to { stroke-dashoffset: var(--offset); } }

.booking-list { margin: 0 0 1.1rem; }
.booking-list > div { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .55rem 0; border-top: 1px solid var(--paper-line); }
.booking-list > div:first-child { border-top: 0; }
.booking-list dt { font-weight: 600; font-size: .85rem; color: var(--text-soft); display: inline-flex; align-items: center; gap: .4rem; }
.booking-list dd { margin: 0; font-weight: 700; font-size: .88rem; color: var(--ink); text-align: right; }

.booking-price-box { display: flex; flex-direction: column; background: var(--paper-dim); border-radius: var(--radius); padding: 1.1rem 1.3rem; margin-bottom: 1.1rem; }
.booking-price-box .price-meta { font-size: .78rem; color: var(--text-faint); }
.price-lg { font-family: var(--serif); font-size: 2.2rem; color: var(--ink); }

.btn-book { width: 100%; justify-content: center; }

.trust-list { list-style: none; padding: 0; margin: 1.2rem 0 0; display: flex; flex-direction: column; gap: .4rem; }
.trust-list li { display: flex; align-items: center; gap: .5rem; font-size: .86rem; font-weight: 600; color: var(--text-soft); }
.trust-list i { color: var(--moss); }

/* ---------- Fotoğraf slider ---------- */
.photos-block { margin-top: 1rem; }
.photos-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.6rem; }
.slider-nav { display: flex; gap: .5rem; flex-shrink: 0; }
.slider-btn { width: 42px; height: 42px; border: 0; border-radius: 50%; background: var(--paper-dim); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; transition: background-color .25s var(--ease), color .25s var(--ease); }
.slider-btn:hover { background: var(--ink); color: var(--paper); }

.photo-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2rem) / 3); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .6rem; }
.photo-frame { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; scroll-snap-align: start; }
.photo-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
.photo-frame:hover img { transform: scale(1.06); }
.photo-cap { position: absolute; left: .6rem; bottom: .6rem; background: rgba(18, 39, 34, .72); color: var(--paper); font-size: .76rem; font-weight: 700; padding: .3rem .7rem; border-radius: 999px; }

@@media (max-width: 1199.98px) {
    .detail-grid { grid-template-columns: 1fr; }
    .side-rail { display: none; }
    .booking-card { position: static; margin-top: 2rem; }
    .room-card { grid-template-columns: 170px minmax(0, 1fr) 150px; }
}

@@media (max-width: 767.98px) {
    .gallery-hero { height: 44vh; min-height: 320px; }
    .facility-grid { grid-template-columns: 1fr; }
    .room-card { grid-template-columns: 1fr; }
    .room-price { align-items: flex-start; text-align: left; border-top: 1px solid var(--paper-line); padding-top: .8rem; }
    .review-summary { grid-template-columns: 1fr; }
    .nearby-list { grid-template-columns: 1fr; }
}
}

<main>
    @if (Model.ErrorMessage != null)
    {
        <div class="container detail-error">
            <div class="state-panel">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2 L14 9 L21 11 L14 13 L12 20 L10 13 L3 11 L10 9 Z" stroke-linejoin="round"/></svg>
                <h3>Bu otel bulunamadı</h3>
                <p>@Model.ErrorMessage</p>
                <a asp-controller="Hotel" asp-action="List" class="btn-brass"><span>Aramaya dön</span></a>
            </div>
        </div>
        return;
    }

    <!-- Galeri Hero -->
    <section class="gallery-hero">
        <img src="@Model.PhotoUrl" alt="@Model.Name">
        <div class="gallery-hero-content">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb sf-breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Hotel" asp-action="List">Oteller</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                    </ol>
                </nav>

                <div class="hero-title-row">
                    <div>
                        <h1 class="hotel-title">@Model.Name</h1>
                        <p class="hotel-address"><i class="bi bi-geo-alt"></i> @Model.LocationText</p>
                    </div>
                    <div class="hero-actions">
                        <button type="button" class="fav-btn" style="width:44px;height:44px;" aria-label="Favorilere ekle"><i class="bi bi-heart"></i></button>
                        <button type="button" class="btn-ghost btn-ghost-light" style="width:44px;height:44px;border-radius:50%;padding:0;" aria-label="Paylaş"><i class="bi bi-share"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="container detail-body">
        <div class="detail-grid">
            <!-- Scroll-spy rayı -->
            <nav class="side-rail" aria-label="Sayfa içi gezinme">
                <a href="#about" data-target="about"><span>Genel Bakış</span></a>
                <a href="#facilities" data-target="facilities"><span>Özellikler</span></a>
                <a href="#location" data-target="location"><span>Konum</span></a>
                <a href="#rooms" data-target="rooms"><span>Odalar</span></a>
                <a href="#reviews" data-target="reviews"><span>Yorumlar</span></a>
            </nav>

            <!-- İçerik -->
            <div class="detail-main">
                <section class="detail-block" id="about">
                    <h2 class="block-title">Otel Hakkında</h2>
                    <div class="about-text"><p>@Model.Description</p></div>
                </section>

                <section class="detail-block" id="facilities">
                    <h2 class="block-title">Popüler Özellikler</h2>
                    <div class="facility-grid">
                        @foreach (var facility in Model.Facilities)
                        {
                            <div class="facility-item">
                                <span class="facility-icon"><i class="bi bi-check2-circle"></i></span>
                                <span class="facility-text"><strong>@facility</strong></span>
                            </div>
                        }
                    </div>
                </section>

                <section class="detail-block" id="location">
                    <h2 class="block-title">Otel Konumu</h2>
                    <div class="location-card">
                        <div class="map-placeholder" aria-label="Otel konumu haritası" role="img">
                            <svg viewBox="0 0 800 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <rect width="800" height="300" fill="#F1ECE1"/>
                                <rect x="40" y="30" width="150" height="90" rx="14" fill="#DCE6DD"/>
                                <rect x="590" y="190" width="170" height="80" rx="14" fill="#DCE6DD"/>
                                <path d="M0 250 C 200 230, 330 280, 520 240 S 760 220, 800 235" stroke="#E4DFD2" stroke-width="16" fill="none"/>
                                <g stroke="#FBF9F5" stroke-linecap="round" fill="none">
                                    <path d="M0 150 L800 130" stroke-width="18"/>
                                    <path d="M260 0 L320 300" stroke-width="16"/>
                                    <path d="M560 0 L500 300" stroke-width="14"/>
                                    <path d="M0 60 L260 80 L560 40 L800 70" stroke-width="10"/>
                                    <path d="M320 210 L800 200" stroke-width="10"/>
                                </g>
                                <g fill="#E4DFD2">
                                    <rect x="340" y="60" width="70" height="55" rx="8"/>
                                    <rect x="420" y="55" width="110" height="60" rx="8"/>
                                    <rect x="340" y="160" width="140" height="35" rx="8"/>
                                </g>
                            </svg>
                            <div class="map-pin">
                                <span class="map-pin-label">@Model.Name</span>
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                        </div>
                        <div class="location-body">
                            <p class="location-address"><i class="bi bi-geo-alt"></i> @Model.LocationText</p>
                            <ul class="nearby-list">
                                <li><span><i class="bi bi-train-front"></i> Merkez İstasyon</span><strong>~1 km</strong></li>
                                <li><span><i class="bi bi-bag"></i> Alışveriş Caddesi</span><strong>~1,5 km</strong></li>
                                <li><span><i class="bi bi-bank"></i> Şehir Merkezi</span><strong>~2,5 km</strong></li>
                                <li><span><i class="bi bi-airplane"></i> Havalimanı</span><strong>~40 km</strong></li>
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="detail-block" id="rooms">
                    <h2 class="block-title">Uygun Odalar</h2>
                    <div class="room-list">
                        <article class="room-card">
                            <div class="room-media"><img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?w=700&q=80&auto=format&fit=crop" alt="Standart Oda" loading="lazy"></div>
                            <div class="room-info">
                                <h3 class="room-name">Standart Oda</h3>
                                <ul class="room-specs">
                                    <li><i class="bi bi-moon-stars"></i> 1 çift kişilik yatak</li>
                                    <li><i class="bi bi-person"></i> 2 yetişkin</li>
                                    <li><i class="bi bi-arrows-angle-expand"></i> 20 m²</li>
                                </ul>
                                <ul class="room-perks">
                                    <li><i class="bi bi-wifi"></i> Ücretsiz Wi-Fi</li>
                                    <li><i class="bi bi-snow"></i> Klima</li>
                                </ul>
                                <span class="policy-text"><i class="bi bi-info-circle"></i> İade edilmez</span>
                            </div>
                            <div class="room-price">
                                <span class="price-meta">gece başına</span>
                                <span class="price">@Model.PriceText</span>
                                <button type="button" class="btn-ghost" style="font-size:.82rem;padding:.6rem 1.1rem;">Odayı Seç</button>
                            </div>
                        </article>

                        <article class="room-card room-card-featured">
                            <div class="room-media">
                                <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?w=700&q=80&auto=format&fit=crop" alt="Superior Oda" loading="lazy">
                                <span class="room-media-badge">En Çok Tercih Edilen</span>
                            </div>
                            <div class="room-info">
                                <h3 class="room-name">Superior Oda</h3>
                                <ul class="room-specs">
                                    <li><i class="bi bi-moon-stars"></i> 1 büyük çift kişilik yatak</li>
                                    <li><i class="bi bi-people"></i> 2 yetişkin + 1 çocuk</li>
                                    <li><i class="bi bi-arrows-angle-expand"></i> 28 m²</li>
                                </ul>
                                <ul class="room-perks">
                                    <li><i class="bi bi-buildings"></i> Şehir manzarası</li>
                                    <li class="perk-positive"><i class="bi bi-cup-hot"></i> Kahvaltı dahil</li>
                                </ul>
                                <span class="policy-text policy-free"><i class="bi bi-check2-circle"></i> Ücretsiz iptal</span>
                            </div>
                            <div class="room-price">
                                <span class="price-meta">gece başına</span>
                                <span class="price">@Model.PriceText</span>
                                <button type="button" class="btn-ghost" style="font-size:.82rem;padding:.6rem 1.1rem;">Odayı Seç</button>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="detail-block" id="reviews" style="border-bottom:0;">
                    <h2 class="block-title">Misafir Değerlendirmeleri</h2>

                    @if (Model.ReviewScore.HasValue)
                    {
                        <div class="review-summary">
                            <div class="review-score-box">
                                <span class="review-big">@Model.ReviewScore</span>
                                <strong>Misafir Puanı</strong>
                                <span>@Model.ReviewCount değerlendirme</span>
                            </div>
                            <div class="review-bars">
                                <div class="bar-row" style="--w: 91%"><span class="bar-label">Temizlik</span><div class="bar-track"><div class="bar-fill"></div></div><span class="bar-value">9,1</span></div>
                                <div class="bar-row" style="--w: 92%"><span class="bar-label">Konum</span><div class="bar-track"><div class="bar-fill"></div></div><span class="bar-value">9,2</span></div>
                                <div class="bar-row" style="--w: 88%"><span class="bar-label">Konfor</span><div class="bar-track"><div class="bar-fill"></div></div><span class="bar-value">8,8</span></div>
                                <div class="bar-row" style="--w: 86%"><span class="bar-label">Wi-Fi</span><div class="bar-track"><div class="bar-fill"></div></div><span class="bar-value">8,6</span></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p style="color:var(--text-soft);">Bu otel için <strong>@Model.ReviewCount</strong> misafir değerlendirmesi bulunuyor.</p>
                    }

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <figure class="review-card">
                                <blockquote>"Konumu çok iyiydi, merkeze yürüme mesafesinde."</blockquote>
                                <figcaption>
                                    <span class="review-avatar">E</span>
                                    <span><strong>Elif</strong><small>Türkiye</small></span>
                                    <span class="review-mini">9,0</span>
                                </figcaption>
                            </figure>
                        </div>
                        <div class="col-md-6">
                            <figure class="review-card">
                                <blockquote>"Oda temiz ve modern, personel ilgiliydi."</blockquote>
                                <figcaption>
                                    <span class="review-avatar">M</span>
                                    <span><strong>Mert</strong><small>Türkiye</small></span>
                                    <span class="review-mini">8,5</span>
                                </figcaption>
                            </figure>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Rezervasyon kartı -->
            <aside class="detail-side">
                <div class="booking-card">
                    <div class="booking-head">
                        <h2 class="booking-title">Konaklama Özeti</h2>
                        @if (Model.ReviewScore.HasValue)
                        {
                            <div class="rating-ring" style="--offset: @(151 - (Model.ReviewScore.Value / 10 * 151));">
                                <svg width="58" height="58" viewBox="0 0 58 58">
                                    <circle class="ring-track" cx="29" cy="29" r="24"></circle>
                                    <circle class="ring-fill" cx="29" cy="29" r="24"></circle>
                                </svg>
                                <span class="ring-score">@Model.ReviewScore</span>
                            </div>
                        }
                    </div>

                    <dl class="booking-list">
                        <div><dt><i class="bi bi-box-arrow-in-right"></i> Giriş</dt><dd id="bookCheckin">&mdash;</dd></div>
                        <div><dt><i class="bi bi-box-arrow-right"></i> Çıkış</dt><dd id="bookCheckout">&mdash;</dd></div>
                        <div><dt><i class="bi bi-people"></i> Misafir</dt><dd>@Model.ReviewCount değerlendirme</dd></div>
                    </dl>

                    <div class="booking-price-box">
                        <span class="price-meta">Gecelik fiyat</span>
                        <span class="price-lg">@Model.PriceText</span>
                    </div>

                    <a href="#rooms" class="btn-brass btn-book"><span>Oda Seç</span> <i class="bi bi-door-open"></i></a>

                    <ul class="trust-list">
                        <li><i class="bi bi-check2"></i> Anında Onay</li>
                        <li><i class="bi bi-check2"></i> Güvenli İşlem</li>
                        <li><i class="bi bi-check2"></i> Ücretsiz İptal Seçenekleri</li>
                    </ul>
                </div>
            </aside>
        </div>

        <!-- Fotoğraf şeridi -->
        <section class="detail-block photos-block" id="hotelPhotos" style="border-bottom:0;">
            <div class="photos-head">
                <div>
                    <h2 class="block-title">@Model.Name Fotoğrafları</h2>
                    <p style="color:var(--text-soft);">Odaları ve otelin sunduğu alanları daha yakından incele.</p>
                </div>
                <div class="slider-nav">
                    <button type="button" class="slider-btn" data-dir="-1" aria-label="Önceki fotoğraflar"><i class="bi bi-chevron-left"></i></button>
                    <button type="button" class="slider-btn" data-dir="1" aria-label="Sonraki fotoğraflar"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
            <div class="photo-track" id="photoTrack">
                <figure class="photo-frame"><img src="@Model.PhotoUrl" alt="@Model.Name" loading="lazy"><span class="photo-cap">Oda</span></figure>
                <figure class="photo-frame"><img src="https://images.unsplash.com/photo-1564501049412-61c2a3083791?w=900&q=80&auto=format&fit=crop" alt="Lobi" loading="lazy"><span class="photo-cap">Lobi</span></figure>
                <figure class="photo-frame"><img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=900&q=80&auto=format&fit=crop" alt="Restoran" loading="lazy"><span class="photo-cap">Restoran</span></figure>
                <figure class="photo-frame"><img src="https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=900&q=80&auto=format&fit=crop" alt="Banyo" loading="lazy"><span class="photo-cap">Banyo</span></figure>
                <figure class="photo-frame"><img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=900&q=80&auto=format&fit=crop" alt="Fitness" loading="lazy"><span class="photo-cap">Fitness</span></figure>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        // Rezervasyon kartındaki giriş/çıkış tarihlerini URL'den doldur
        (function () {
            var params = new URLSearchParams(window.location.search);
            var checkin = params.get('checkin');
            var checkout = params.get('checkout');
            if (checkin) document.getElementById('bookCheckin').textContent = checkin;
            if (checkout) document.getElementById('bookCheckout').textContent = checkout;
        })();

        // Scroll-spy: içerik bloklarını izleyip yan raydaki aktif noktayı günceller
        (function () {
            var links = document.querySelectorAll('.side-rail a');
            if (!links.length || !('IntersectionObserver' in window)) return;

            var map = {};
            links.forEach(function (l) { map[l.dataset.target] = l; });

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        links.forEach(function (l) { l.classList.remove('is-active'); });
                        map[entry.target.id].classList.add('is-active');
                    }
                });
            }, { rootMargin: '-40% 0px -50% 0px' });

            Object.keys(map).forEach(function (id) {
                var el = document.getElementById(id);
                if (el) observer.observe(el);
            });
        })();

        // Değerlendirme çubuklarını görünür olunca doldur
        (function () {
            var bars = document.querySelectorAll('.bar-row');
            if (!bars.length || !('IntersectionObserver' in window)) {
                bars.forEach(function (b) { b.classList.add('is-visible'); });
                return;
            }
            var obs = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); }
                });
            }, { threshold: .4 });
            bars.forEach(function (b) { obs.observe(b); });
        })();

        // Fotoğraf şeridi kaydırma
        (function () {
            var track = document.getElementById('photoTrack');
            if (!track) return;
            document.querySelectorAll('.slider-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var item = track.querySelector('.photo-frame');
                    var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
                    var step = item ? item.offsetWidth + gap : track.clientWidth;
                    track.scrollBy({ left: step * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
                });
            });
        })();
    </script>
}
